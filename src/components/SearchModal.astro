---
// SearchModal.astro
---

<div id="search-modal" class="fixed inset-0 z-50 hidden bg-zinc-900/60 backdrop-blur-sm transition-opacity">
  <div class="flex min-h-full items-start justify-center p-4 pt-20 sm:p-6 sm:pt-28">
    <div
      class="w-full max-w-xl transform rounded-xl bg-white dark:bg-zinc-900 p-4 shadow-2xl border border-zinc-200 dark:border-zinc-800 transition-all"
    >
      <!-- Search Input -->
      <div class="relative flex items-center border-b border-zinc-200 dark:border-zinc-800 pb-3">
        <svg class="w-5 h-5 text-zinc-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="搜索文章标题、标签或内容... (Esc 关闭)"
          class="w-full bg-transparent text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none text-sm sm:text-base"
        />
        <button id="close-search-btn" class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 p-1 text-xs border border-zinc-200 dark:border-zinc-700 rounded px-1.5">
          ESC
        </button>
      </div>

      <!-- Results List -->
      <div id="search-results" class="mt-3 max-h-80 overflow-y-auto divide-y divide-zinc-100 dark:divide-zinc-800/60">
        <div id="search-empty" class="py-8 text-center text-sm text-zinc-400">
          输入关键词以搜索 35 篇历史记录
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  let searchData: any[] = [];
  let fuse: any = null;

  async function loadSearchData() {
    if (searchData.length === 0) {
      try {
        const res = await fetch('/search.json');
        searchData = await res.json();
        fuse = new Fuse(searchData, {
          keys: [
            { name: 'title', weight: 0.5 },
            { name: 'description', weight: 0.3 },
            { name: 'tags', weight: 0.2 },
          ],
          threshold: 0.4,
          ignoreLocation: true,
        });
      } catch (err) {
        console.error('Failed to load search data', err);
      }
    }
  }

  function setupSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results');
    const closeBtn = document.getElementById('close-search-btn');

    function openModal() {
      modal?.classList.remove('hidden');
      loadSearchData();
      setTimeout(() => input?.focus(), 50);
    }

    function closeModal() {
      modal?.classList.add('hidden');
      if (input) input.value = '';
      if (resultsContainer) {
        resultsContainer.innerHTML = '<div class="py-8 text-center text-sm text-zinc-400">输入关键词以搜索 35 篇历史记录</div>';
      }
    }

    document.querySelectorAll('[data-open-search]').forEach((btn) => {
      btn.addEventListener('click', openModal);
    });

    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal || (e.target as HTMLElement).classList.contains('items-start')) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal?.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });

    input?.addEventListener('input', () => {
      const query = input.value.trim();
      if (!query || !fuse) {
        if (resultsContainer) {
          resultsContainer.innerHTML = '<div class="py-8 text-center text-sm text-zinc-400">输入关键词以搜索 35 篇历史记录</div>';
        }
        return;
      }

      const results = fuse.search(query).slice(0, 8);
      if (results.length === 0) {
        if (resultsContainer) {
          resultsContainer.innerHTML = `<div class="py-8 text-center text-sm text-zinc-400">未找到与 "${query}" 相关的文章</div>`;
        }
        return;
      }

      const html = results
        .map(({ item }: any) => {
          return `
            <a href="/posts/${item.slug}" class="block py-3 px-2 rounded-lg hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors group">
              <div class="text-sm font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">
                ${item.title}
              </div>
              ${item.description ? `<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">${item.description}</p>` : ''}
              <div class="mt-1.5 flex items-center gap-2 text-xs text-zinc-400">
                <span>${item.date}</span>
                ${item.tags && item.tags.length ? `<span>•</span><span>#${item.tags.join(' #')}</span>` : ''}
              </div>
            </a>
          `;
        })
        .join('');

      if (resultsContainer) {
        resultsContainer.innerHTML = html;
      }
    });
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
