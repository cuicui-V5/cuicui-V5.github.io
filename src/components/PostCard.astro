---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = formatDate(post.data.date);
---

<article class="group relative flex flex-col items-start py-6 transition-all">
  <div class="flex items-center gap-3 text-xs text-zinc-400 dark:text-zinc-500 font-mono">
    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    {post.data.categories && post.data.categories.length > 0 && (
      <>
        <span>•</span>
        <span class="text-zinc-500 dark:text-zinc-400">{post.data.categories[0]}</span>
      </>
    )}
  </div>

  <h2 class="mt-2 text-lg sm:text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
    <a href={`/posts/${post.slug}`}>
      <span class="absolute inset-0 z-0"></span>
      {post.data.title}
    </a>
  </h2>

  {post.data.description && (
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
      {post.data.description}
    </p>
  )}

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5 z-10">
      {post.data.tags.slice(0, 4).map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>
