---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getPostReadingTime, getCategoryBadgeStyle, getTagBadgeStyle } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = formatDate(post.data.date);
const stats = getPostReadingTime(post.body);
const mainCategory = post.data.categories && post.data.categories.length > 0 ? post.data.categories[0] : null;
const categoryStyle = mainCategory ? getCategoryBadgeStyle(mainCategory) : null;
---

<article class="group relative flex flex-col p-6 rounded-2xl bg-white/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800/70 hover:border-indigo-300 dark:hover:border-indigo-500/40 hover:shadow-[0_8px_25px_rgba(99,102,241,0.07)] transition-all duration-300 backdrop-blur-xs mb-4">
  <!-- Top meta line -->
  <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 dark:text-slate-400 mb-2.5">
    {mainCategory && categoryStyle && (
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium border ${categoryStyle.bg} ${categoryStyle.text} ${categoryStyle.border}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${categoryStyle.dot}`}></span>
        {mainCategory}
      </span>
    )}

    <time datetime={post.data.date.toISOString()} class="font-mono text-slate-400 dark:text-slate-500">
      {formattedDate}
    </time>

    <span class="text-slate-300 dark:text-slate-700">•</span>
    <span class="text-slate-400 dark:text-slate-500">{stats.minutes} 分钟阅读</span>
  </div>

  <!-- Title -->
  <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug">
    <a href={`/posts/${post.slug}`}>
      <span class="absolute inset-0 z-0"></span>
      {post.data.title}
    </a>
  </h2>

  <!-- Description -->
  {post.data.description && (
    <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
      {post.data.description}
    </p>
  )}

  <!-- Tags -->
  {post.data.tags && post.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2 z-10">
      {post.data.tags.slice(0, 5).map((tag) => {
        const tagStyle = getTagBadgeStyle(tag);
        return (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class={`inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-medium border transition-colors ${tagStyle.bg} ${tagStyle.text} ${tagStyle.border} ${tagStyle.hover}`}
          >
            #{tag}
          </a>
        );
      })}
    </div>
  )}
</article>
