---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: '文章', href: '/posts' },
  { label: '归档', href: '/archive' },
  { label: '标签', href: '/tags' },
  { label: '关于', href: '/about' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-[#0f111a]/80 backdrop-blur-md transition-colors">
  <div class="max-w-6xl xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-2">
      <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100 font-mono flex items-baseline">
        cuicui<span class="text-indigo-500 font-extrabold text-2xl leading-none">.</span>
      </span>
      <span class="hidden sm:inline-block text-[11px] font-mono px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/50">
        Garden
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-2 text-sm font-medium">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-lg transition-all ${
              isActive
                ? 'text-indigo-600 dark:text-indigo-400 bg-indigo-50/80 dark:bg-indigo-950/50 font-semibold'
                : 'text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-300 hover:bg-slate-100/60 dark:hover:bg-slate-800/50'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Action Tools -->
    <div class="flex items-center gap-2.5">
      <!-- Search Button -->
      <button
        type="button"
        data-open-search
        aria-label="Search posts"
        class="flex items-center gap-2 px-3 py-1.5 text-xs text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-300 bg-slate-100/80 dark:bg-slate-800/80 hover:bg-indigo-50/80 dark:hover:bg-indigo-950/60 rounded-xl border border-slate-200/70 dark:border-slate-700/60 hover:border-indigo-200 dark:hover:border-indigo-800 transition-all shadow-xs"
      >
        <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="hidden sm:inline">全站搜索</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white dark:bg-slate-900 rounded border border-slate-200 dark:border-slate-700 text-slate-400">
          Ctrl K
        </kbd>
      </button>

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        class="md:hidden p-2 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 px-4 py-3 bg-white dark:bg-slate-900 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-lg text-sm text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50/50 dark:hover:bg-indigo-950/40"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
