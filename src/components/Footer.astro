---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-zinc-200/80 dark:border-zinc-800/80 py-10 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-400">
    <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
      <span>© {currentYear} cuicui</span>
      <span class="hidden sm:inline">•</span>
      <span class="italic text-zinc-400 dark:text-zinc-500">“弱小和无知从不是生存的障碍，傲慢才是”</span>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="/rss.xml"
        class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-8.18v4.819c10.563.064 19.135 8.629 19.2 19.181h4.798c-.064-13.208-10.778-23.93-23.998-24z"/>
        </svg>
        RSS
      </a>
      <span>•</span>
      <a
        href="https://github.com/cuicui-V5/cuicui-V5.github.io"
        class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        GitHub
      </a>
      <span>•</span>
      <button
        id="back-to-top"
        type="button"
        class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
        aria-label="Back to top"
      >
        回顶端 ↑
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
