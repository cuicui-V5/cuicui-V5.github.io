---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc-container text-xs text-slate-500 dark:text-slate-400">
    <div class="font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200 mb-3 text-[11px] flex items-center gap-2">
      <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h7" />
      </svg>
      文章目录
    </div>
    <ul class="space-y-1 border-l border-slate-200 dark:border-slate-800">
      {filteredHeadings.map((heading) => {
        const indentClass = heading.depth === 3 ? 'pl-6' : heading.depth === 2 ? 'pl-4' : 'pl-2.5';
        return (
          <li>
            <a
              href={`#${heading.slug}`}
              class={`toc-link block -ml-px border-l-2 border-transparent ${indentClass} py-1 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all line-clamp-1 text-slate-600 dark:text-slate-400`}
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<script is:inline>
  function setupTocHighlight() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            document.querySelectorAll('.toc-link').forEach((link) => {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add('border-indigo-500', 'text-indigo-600', 'dark:text-indigo-400', 'bg-indigo-50/70', 'dark:bg-indigo-950/40', 'rounded-r-md', 'font-medium');
                link.classList.remove('border-transparent', 'text-slate-600', 'dark:text-slate-400');
              } else {
                link.classList.remove('border-indigo-500', 'text-indigo-600', 'dark:text-indigo-400', 'bg-indigo-50/70', 'dark:bg-indigo-950/40', 'rounded-r-md', 'font-medium');
                link.classList.add('border-transparent', 'text-slate-600', 'dark:text-slate-400');
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0% -60% 0%' }
    );

    document.querySelectorAll('article h1, article h2, article h3').forEach((h) => {
      observer.observe(h);
    });
  }

  setupTocHighlight();
  document.addEventListener('astro:after-swap', setupTocHighlight);
</script>
