---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPostsByDate, getCategoryBadgeStyle } from '../utils/posts';

const allPosts = await getCollection('blog');
const sortedPosts = sortPostsByDate(allPosts);

// Group by Year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = new Date(post.data.date).getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<string, typeof sortedPosts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="文章归档 - cuicui'Blog" description="cuicui'Blog 历史文章时间线归档">
  <div class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 font-mono">
      归档 / Archive
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-mono">
      时光荏苒，共留存 {sortedPosts.length} 篇文字记录
    </p>
  </div>

  <div class="space-y-12">
    {years.map((year) => (
      <section class="p-6 sm:p-8 rounded-3xl bg-white/60 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 shadow-xs">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 font-mono">
            {year}
          </h2>
          <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/60">
            {postsByYear[year].length} 篇
          </span>
          <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
        </div>

        <ul class="space-y-3.5 pl-3 border-l-2 border-indigo-100 dark:border-indigo-950">
          {postsByYear[year].map((post) => {
            const date = new Date(post.data.date);
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const cat = post.data.categories && post.data.categories.length > 0 ? post.data.categories[0] : null;
            const catStyle = cat ? getCategoryBadgeStyle(cat) : null;

            return (
              <li class="group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4 pl-4 -ml-[2px] border-l-2 border-transparent hover:border-indigo-500 transition-colors py-1">
                <time class="text-xs font-mono text-slate-400 dark:text-slate-500 shrink-0 w-12">
                  {month}-{day}
                </time>
                <a
                  href={`/posts/${post.slug}`}
                  class="text-sm sm:text-base font-medium text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1 flex-1"
                >
                  {post.data.title}
                </a>
                {cat && catStyle && (
                  <span class={`hidden sm:inline-flex text-[11px] px-2 py-0.5 rounded-full border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>
                    {cat}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
