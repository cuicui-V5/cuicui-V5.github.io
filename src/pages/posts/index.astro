---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { sortPostsByDate, getAllCategories, getCategoryBadgeStyle } from '../../utils/posts';

const allPosts = await getCollection('blog');
const sortedPosts = sortPostsByDate(allPosts);
const categories = getAllCategories(allPosts);
---

<BaseLayout title="所有文章 - cuicui'Blog" description="浏览 cuicui 博客的所有技术与思考文章">
  <div class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 font-mono">
          文章 / Posts
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-mono">
          共收录 {sortedPosts.length} 篇历史记录
        </p>
      </div>

      <a
        href="/archive"
        class="self-start sm:self-auto text-xs font-mono text-indigo-600 dark:text-indigo-400 flex items-center gap-1.5 border border-indigo-200/80 dark:border-indigo-800/80 bg-indigo-50/50 dark:bg-indigo-950/30 rounded-xl px-3.5 py-2 hover:bg-indigo-100/60 dark:hover:bg-indigo-900/50 transition-colors shadow-xs"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        进入时间线归档
      </a>
    </div>

    <!-- Category Filter Badges -->
    {categories.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="text-xs text-slate-400 self-center mr-1 font-mono">分类:</span>
        {categories.map(({ category, count }) => {
          const style = getCategoryBadgeStyle(category);
          return (
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium border ${style.bg} ${style.text} ${style.border}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${style.dot}`}></span>
              <span>{category}</span>
              <span class="text-[10px] opacity-70 font-mono">({count})</span>
            </span>
          );
        })}
      </div>
    )}
  </div>

  <!-- Posts Grid / List -->
  <div class="space-y-4">
    {sortedPosts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
