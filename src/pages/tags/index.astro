---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getTagBadgeStyle } from '../../utils/posts';

const allPosts = await getCollection('blog');
const tags = getAllTags(allPosts);
---

<BaseLayout title="所有标签 - cuicui'Blog" description="cuicui'Blog 的文章标签索引">
  <div class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 font-mono">
      标签 / Tags
    </h1>
    <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-mono">
      共有 {tags.length} 个技术与生活探索主题
    </p>
  </div>

  <div class="p-8 sm:p-10 rounded-3xl bg-white/60 dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 shadow-xs">
    <div class="flex flex-wrap gap-3">
      {tags.map(({ tag, count }) => {
        const tagStyle = getTagBadgeStyle(tag);
        return (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class={`inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium border transition-all shadow-2xs hover:scale-105 ${tagStyle.bg} ${tagStyle.text} ${tagStyle.border} ${tagStyle.hover}`}
          >
            <span>#{tag}</span>
            <span class="text-xs font-mono opacity-70 px-1.5 py-0.5 rounded-full bg-white/80 dark:bg-slate-900/60">
              {count}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
