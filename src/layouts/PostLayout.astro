---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, getPostReadingTime, getCategoryBadgeStyle, getTagBadgeStyle } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const formattedDate = formatDate(post.data.date);
const stats = getPostReadingTime(post.body);
---

<BaseLayout title={`${post.data.title} - cuicui'Blog`} description={post.data.description}>
  <!-- Top Reading Progress Indicator -->
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-sky-400 via-indigo-500 to-purple-500 z-50 transition-all duration-75" style="width: 0%"></div>

  <article class="relative">
    <!-- Back Link -->
    <a
      href="/posts"
      class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 mb-8 transition-colors px-3 py-1.5 rounded-lg bg-slate-100/60 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/50"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      返回全部文章
    </a>

    <!-- Header Section -->
    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
        {post.data.categories && post.data.categories.map((cat) => {
          const style = getCategoryBadgeStyle(cat);
          return (
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium border ${style.bg} ${style.text} ${style.border}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${style.dot}`}></span>
              {cat}
            </span>
          );
        })}
        <time datetime={post.data.date.toISOString()} class="font-mono text-slate-400 dark:text-slate-500">{formattedDate}</time>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="text-slate-500 dark:text-slate-400">共约 {stats.words} 字</span>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <span class="text-slate-500 dark:text-slate-400">预计阅读 {stats.minutes} 分钟</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100 leading-tight">
        {post.data.title}
      </h1>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => {
            const style = getTagBadgeStyle(tag);
            return (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium border transition-colors ${style.bg} ${style.text} ${style.border} ${style.hover}`}
              >
                #{tag}
              </a>
            );
          })}
        </div>
      )}
    </header>

    <!-- Main Content & Sidebar Grid (Expanded Viewport) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-14">
      <!-- Article Body -->
      <div class="lg:col-span-8 xl:col-span-9 min-w-0">
        <div class="prose dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 leading-relaxed break-words">
          <slot />
        </div>

        <!-- Prev / Next Navigation -->
        <nav class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={`/posts/${prevPost.slug}`}
              class="group p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-600 bg-white/60 dark:bg-slate-900/40 transition-all shadow-xs"
            >
              <div class="text-[11px] font-mono text-indigo-500 dark:text-indigo-400 mb-1.5 flex items-center gap-1">
                <span>← 上一篇</span>
              </div>
              <div class="text-sm font-medium text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1">
                {prevPost.data.title}
              </div>
            </a>
          ) : <div />}

          {nextPost ? (
            <a
              href={`/posts/${nextPost.slug}`}
              class="group p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-600 bg-white/60 dark:bg-slate-900/40 transition-all shadow-xs text-right"
            >
              <div class="text-[11px] font-mono text-indigo-500 dark:text-indigo-400 mb-1.5 flex items-center justify-end gap-1">
                <span>下一篇 →</span>
              </div>
              <div class="text-sm font-medium text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1">
                {nextPost.data.title}
              </div>
            </a>
          ) : <div />}
        </nav>
      </div>

      <!-- Desktop Sticky TOC with Glass Card -->
      <aside class="hidden lg:block lg:col-span-4 xl:col-span-3">
        <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto p-5 rounded-2xl bg-white/70 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800/80 backdrop-blur-sm shadow-xs">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  // Setup Reading Progress & Copy Buttons
  function initPostFeatures() {
    // 1. Reading Progress
    const progressBar = document.getElementById('reading-progress');
    window.addEventListener('scroll', () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrolled = (window.scrollY / docHeight) * 100;
      if (progressBar) {
        progressBar.style.width = Math.min(100, Math.max(0, scrolled)) + '%';
      }
    });

    // 2. Code Block Copy Buttons
    document.querySelectorAll('pre.astro-code').forEach((pre) => {
      if (pre.querySelector('.copy-code-btn')) return;

      const button = document.createElement('button');
      button.className = 'copy-code-btn';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = '已复制!';
          button.classList.add('text-indigo-400');
          setTimeout(() => {
            button.textContent = '复制';
            button.classList.remove('text-indigo-400');
          }, 2000);
        } catch (err) {
          button.textContent = '失败';
          setTimeout(() => {
            button.textContent = '复制';
          }, 2000);
        }
      });

      pre.appendChild(button);
    });
  }

  initPostFeatures();
  document.addEventListener('astro:after-swap', initPostFeatures);
</script>
